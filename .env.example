# Names only. Do not commit values. Public OSM and GTFS endpoints need no API keys.
# Optional overrides for the dev-server location proxy. Leave unset to use the defaults.
XDG_CACHE_HOME
PARTY_OUTPUT_DIR
OSRM_BASE_URL
NOMINATIM_BASE_URL
PHOTON_BASE_URL
OVERPASS_URLS
CALTRAIN_GTFS_URL
VTA_GTFS_URL
OTP_BASE_URL
GTFS_CACHE_DIR
SUPABASE_URL
SUPABASE_PUBLISHABLE_KEY
DATABASE_URL
PGHOST
PGPORT
PGUSER
PGPASSWORD
PGDATABASE
PGSSLMODE
DB_SCHEMA
ENABLE_TEST_RESOLVER
# Screenshot OCR: npm run py:sync (uv.lock). Optional override: ROOST_PYTHON
# Zillow CLI and refresh job. The Roost rental search does not read these.
SCRAPINGDOG_API_KEY
# Pipe-separated label => URL pairs. Do not split Zillow URLs on commas.
ZILLOW_SEARCH_SOURCES
ZILLOW_REFRESH_PROVIDER
ZILLOW_REFRESH_TIMEOUT
ZILLOW_REFRESH_LIMIT
ZILLOW_JOB_TIMEOUT_SECONDS
ZILLOW_REFRESH_CRON
# Set to 0 to disable the in-process daily timer. Railway sets RAILWAY_ENVIRONMENT, which starts it.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
