# Names only. Do not commit values. Public OSM and GTFS endpoints need no API keys.
# Optional overrides for the dev-server location proxy. Leave unset to use the defaults.
XDG_CACHE_HOME
PARTY_OUTPUT_DIR
OSRM_BASE_URL
NOMINATIM_BASE_URL
PHOTON_BASE_URL
OVERPASS_URLS
CALTRAIN_GTFS_URL
VTA_GTFS_URL
OTP_BASE_URL
GTFS_CACHE_DIR
SUPABASE_URL
SUPABASE_PUBLISHABLE_KEY
DATABASE_URL
PGHOST
PGPORT
PGUSER
PGPASSWORD
PGDATABASE
PGSSLMODE
DB_SCHEMA
ENABLE_TEST_RESOLVER
ROOST_DATA_DIR
ROOST_PUBLIC_URL
ROOST_STRICT_HEALTH
PORT
# Screenshot OCR: npm run py:sync (uv.lock). Optional override: ROOST_PYTHON
# Redfin daily cache. Sale prices are never written to listings.price_monthly.
REDFIN_SEARCH_URL
REDFIN_REFRESH_HOURS


VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
